# ============================================================
# WalkSafe Backend - Environment Variables
# ============================================================
# Copy this file to .env and replace all placeholder values
# with your actual credentials:
#
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT verification (find this in Supabase dashboard → Settings → API)
# For symmetric HS256 validation (used by local Supabase emulation):
SUPABASE_JWT_SECRET=your-jwt-secret-here

# For asymmetric ES256 JWKS validation (JSON string of public keys, used in production/cloud):
# SUPABASE_JWKS='{"keys": [{"x": "...", "y": "...", "alg": "ES256", "crv": "P-256", "ext": true, "kid": "...", "kty": "EC", "key_ops": ["verify"]}]}'

# Database (Supabase direct connection string)
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Routing engine (Valhalla via Docker)
VALHALLA_BASE_URL=http://localhost:8002

# Geocoding
PHOTON_BASE_URL=https://photon.komoot.io

# Map tiles (get a free key at https://www.maptiler.com)
MAPTILER_API_KEY=your-maptiler-api-key-here

# Admin moderation (choose a long random string, e.g. via: python -c "import secrets; print(secrets.token_urlsafe(36))")
ADMIN_API_KEY=your-admin-api-key-here

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn-here
